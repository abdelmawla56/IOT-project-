<?xml version="1.0" encoding="UTF-8" ?>
<file-rbac>
    <users>
        <user>
            <name>iot-client</name>
            <password>iot-password</password>
            <roles>
                <role>floor-node</role>
            </roles>
        </user>
        <user>
            <name>gateway-admin</name>
            <password>gateway-password</password>
            <roles>
                <role>admin</role>
            </roles>
        </user>
    </users>

    <roles>
        <role>
            <id>floor-node</id>
            <permissions>
                <!-- Nodes can only publish to their own building/floor -->
                <permission>
                    <topic>campus/b01/#</topic>
                    <activity>PUBLISH</activity>
                </permission>
                <permission>
                    <topic>campus/b01/+/+/cmd</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>admin</id>
            <permissions>
                <permission>
                    <topic>#</topic>
                    <activity>ALL</activity>
                </permission>
            </permissions>
        </role>
    </roles>
</file-rbac>
